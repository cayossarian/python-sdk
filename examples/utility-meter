# ─── Defaults ─────────────────────────────────────────────────────────────────

DEFAULT_DOE_ENDPOINT_PORT = 8765
DEFAULT_BROKER_CFG_ENV = "EBUS_BROKER_CFG"

# eBus utility-meter device type per the data model.
DEVICE_TYPE = "energy.ebus.device.utility-meter"

# Capability node types.
CAPABILITY_INFO = "energy.ebus.capability.info"
CAPABILITY_METER = "energy.ebus.capability.meter"
CAPABILITY_STATUS = "energy.ebus.capability.status"
CAPABILITY_DOE = "energy.ebus.capability.doe"

# doe capability: two json properties, one per direction. Each holds a JSON
# array of envelope objects per the eBus utility-meter data model (v0.2).
DOE_DIRECTIONS = ("import-limit", "export-limit")

# Envelope `source` enum (absent = UNKNOWN) per the data model.
DOE_SOURCES = frozenset(
    {"CONTRACT", "REGULATOR", "EQUIPMENT", "GRID", "UNKNOWN"}
)


# ─── Logger boilerplate ───────────────────────────────────────────────────────


def _make_logger(name: str, level: int = logging.INFO) -> logging.Logger:
    logger = logging.getLogger(name)
    logger.setLevel(level)
    if not logger.handlers:
        handler = logging.StreamHandler()
        handler.setFormatter(
            logging.Formatter(
                "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
            )
        )
        logger.addHandler(handler)
    return logger


# ─── Pure model: utility-meter state ──────────────────────────────────────────


class UtilityMeter:
    """
    Pure-Python model of the utility meter's published state.

    Holds the values for `info`, `meter`, `status`, and `doe` properties.
    Knows nothing about MQTT — the adapter below translates this state to
    Homie/eBus topics.

    Values change via `set_doe_*` methods (driven by the HTTP DOE endpoint)
    and via `tick()` (driven by a periodic thread that simulates meter
    measurement updates). Subscribers register callbacks via
    `add_property_on_change_callback`.
    """

    def __init__(
        self,
        config: Dict[str, Any],
        logger: Optional[logging.Logger] = None,
    ):
        self._logger = logger or _make_logger(self.__class__.__name__)
        self._config = config
        self._props = GroupedPropertyDict()
        self._populate_info()
        self._populate_meter()
        self._populate_status()
        self._populate_doe()

    # ── info ──

    def _populate_info(self):
        """Static nameplate properties from config."""
        info = self._config.get("info", {})
        # TODO: validate that the standard `info` properties from the
        # eBus utility-meter data model are populated (vendor-name, model,
        # serial-number, meter-form, meter-class, phases, neutral-connected,
        # nominal-frequency, nominal-phase-angle, nominal-voltage-*).
        for key, value in info.items():
            self._props.add_property_from_dict(
                "info", {"id": key, "type": type(value), "value": value}
            )

    # ── meter ──

    def _populate_meter(self):
        """Synthesised instantaneous + cumulative measurements."""
        # TODO: drive these from a synthetic-load model rather than static
        # config so the demo is more illustrative. For scaffold purposes,
        # config-supplied values are sufficient.
        meter = self._config.get("meter", {})
        for key, value in meter.items():
            self._props.add_property_from_dict(
                "meter", {"id": key, "type": type(value), "value": value}
            )

    # ── status ──

    def _populate_status(self):
        defaults = {
            "communication-state": "OK",
            "time-sync-state": "LOCKED",
        }
        defaults.update(self._config.get("status", {}))
        for key, value in defaults.items():
            self._props.add_property_from_dict(
                "status", {"id": key, "type": type(value), "value": value}
            )

    # ── doe ──

    def _populate_doe(self):
        """
        Initial DOE envelopes from config. May be empty / absent — DOE is
        publish-on-change and a meter that signals no envelope simply omits
        the property. Config supplies `doe.import-limit` / `doe.export-limit`
        as JSON arrays of envelope objects; each becomes one `json` property.
        """
        doe = self._config.get("doe", {})
        for direction in DOE_DIRECTIONS:
            envelopes = doe.get(direction)
            if envelopes:
                self._props.add_property_from_dict(
                    "doe",
                    {"id": direction, "type": "json", "value": list(envelopes)},
                )

    def set_doe_import_limit(self, envelopes):
        """Set the import-side DOE schedule atomically. See `_set_doe`."""
        self._set_doe("import-limit", envelopes)

    def set_doe_export_limit(self, envelopes):
        """Set the export-side DOE schedule atomically. See `_set_doe`."""
        self._set_doe("export-limit", envelopes)

    def _set_doe(self, direction: str, envelopes):
        """
        Set one direction's DOE envelope as a single `json` array, atomically.

        `envelopes` is a single envelope dict, a list of envelope dicts (the
        retained schedule), or None to clear the signal. A dict is wrapped in
        a one-element array. Setting None retracts the retained topic, which
        the data model treats as absence (no meter-signaled limit for that
        direction). The whole array is one retained value, so each update is a
        single atomic transaction — the whole point of the json-per-direction
        model over parallel scalar topics.
        """
        if direction not in DOE_DIRECTIONS:
            raise ValueError(f"unknown doe direction: {direction}")
        if envelopes is None:
            value = None
        elif isinstance(envelopes, dict):
            value = [envelopes]
        else:
            value = list(envelopes)
        self._set_or_clear("doe", direction, value, "json")

    def _set_or_clear(self, group, prop_id, value, py_type):
        try:
            existing = self._props.get(group, prop_id)
        except KeyError:
            existing = None
        if existing is None:
            if value is not None:
                self._props.add_property_from_dict(
                    group, {"id": prop_id, "type": py_type, "value": value}
                )
        else:
            existing.set_value(value)

    # ── tick (periodic synthetic update) ──

    def tick(self):
        """
        Called periodically to nudge meter measurements so consumers can see
        live changes. Scaffold: TODO — implement synthetic load model.
        """
        # TODO: synthesise plausible variation on active-power / voltage /
        # current; advance imported-energy / exported-energy counters.
        pass

    # ── callback registration ──

    def add_property_on_change_callback(self, group, prop_id, callback):
        return self._props.add_property_on_change_callback(
            group, prop_id, callback
        )

    def get_property(self, group, prop_id) -> Property:
        return self._props.get(group, prop_id)

    def as_dict(self) -> dict:
        return self._props.as_dict()


# ─── Adapter: model → Homie/eBus topics ───────────────────────────────────────


def _set_homie_property_from_property(
    homie_property: homie.Property, prop: Property
) -> bool:
    """Callback used to mirror UtilityMeter property values onto Homie."""
    return homie_property.set_value(prop.value())


