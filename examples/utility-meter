class UtilityMeterAdapter:
    """
    Translates a UtilityMeter to a Homie 5 device on the eBus broker.

    Creates one root device of type `energy.ebus.device.utility-meter` with
    four capability nodes (`info`, `meter`, `status`, `doe`). Each Homie
    property is mirrored from the corresponding UtilityMeter property via a
    callback.
    """

    def __init__(
        self,
        meter: UtilityMeter,
        device_id: str,
        device_name: str,
        mqtt_cfg: Dict[str, Any],
        logger: Optional[logging.Logger] = None,
    ):
        self._logger = logger or _make_logger(self.__class__.__name__)
        self._meter = meter
        self._device_id = device_id
        self._device_name = device_name
        self._mqtt_cfg = mqtt_cfg
        self._homie_device: Optional[homie.Device] = None
        self._create_device_and_nodes()

    @staticmethod
    def load_broker_config(config_file: str) -> Dict[str, Any]:
        with open(config_file, "r") as fp:
            return json.load(fp)

    # ── homie device + nodes ──

    def _create_homie_device(self) -> homie.Device:
        device = homie.Device(
            self._device_id,
            name=self._device_name,
            type=DEVICE_TYPE,
            mqtt_cfg=self._mqtt_cfg,
        )
        device.start_mqtt_client()
        return device

    def _add_capability_node(
        self,
        node_id: str,
        node_type: str,
        node_name: str,
        meter_group: str,
    ) -> homie.Node:
        node = self._homie_device.add_node_from_dict(
            {"id": node_id, "name": node_name, "type": node_type}
        )
        self._homie_nodes[meter_group] = node
        if not self._meter._props.has_group(meter_group):
            # Empty capability node — properties may be added at runtime
            # (e.g. doe values arriving via the HTTP endpoint). The
            # PROPERTY_ADDED observer registered below will mirror them
            # to Homie when they arrive.
            return node
        for prop_id, prop in self._meter._props.items(meter_group):
            self._add_homie_property(node, meter_group, prop_id, prop)
        return node

    def _add_homie_property(
        self,
        node: homie.Node,
        meter_group: str,
        prop_id: str,
        prop: Property,
    ):
        """
        Add a single Homie property to `node`, mirroring the meter
        Property `prop`, and wire a change callback so subsequent
        set_value() calls on the meter property republish to Homie.
        Used both at startup (for properties seeded from config) and at
        runtime (for properties added by the PROPERTY_ADDED observer).
        """
        if prop_id in self._homie_property_ids.get(meter_group, set()):
            return  # already mirrored
        hint = HOMIE_PROPERTY_HINTS.get(meter_group, {}).get(prop_id, {})
        property_dict = {"id": prop_id, "value": prop.value()}
        if "datatype" in hint:
            property_dict["datatype"] = hint["datatype"]
        else:
            inferred = homie.datatype_from_type(prop.type())
            if inferred:
                property_dict["datatype"] = inferred
        if "unit" in hint:
            property_dict["unit"] = hint["unit"]
        homie_property = node.add_property_from_dict(property_dict)
        self._meter.add_property_on_change_callback(
            meter_group,
            prop_id,
            partial(_set_homie_property_from_property, homie_property),
        )
        self._homie_property_ids.setdefault(meter_group, set()).add(prop_id)

    def _on_meter_property_event(
        self,
        event_type: ChangeEvent,
        group_name: str = None,
        property_id: str = None,
        property: Property = None,
        **kwargs,
    ):
        """
        Observer callback for the meter's GroupedPropertyDict. Mirrors
        runtime-added properties (e.g. doe values arriving via HTTP after
        startup) to Homie.
        """
        if event_type != ChangeEvent.PROPERTY_ADDED:
            return
        node = self._homie_nodes.get(group_name)
        if node is None:
            self._logger.warning(
                "reason=runtimePropertyAddUnknownGroup,group=%s,propertyId=%s",
                group_name, property_id,
            )
            return
        self._add_homie_property(node, group_name, property_id, property)

    def _create_device_and_nodes(self):
        self._homie_device = self._create_homie_device()
        self._homie_nodes: Dict[str, homie.Node] = {}
        self._homie_property_ids: Dict[str, set] = {}
        self._add_capability_node(
            "info", CAPABILITY_INFO, "Meter identity", "info"
        )
        self._add_capability_node(
            "meter",
            CAPABILITY_METER,
            "Electrical measurements",
            "meter",
        )
        self._add_capability_node(
            "status", CAPABILITY_STATUS, "Meter operational state", "status"
        )
        self._add_capability_node(
            "doe",
            CAPABILITY_DOE,
            "Utility-signalled operating envelope",
            "doe",
        )
        # Observe runtime property additions so values arriving after
        # device startup (typical for doe via the HTTP endpoint) are
        # mirrored onto Homie.
        self._meter._props.add_observer(
            self._on_meter_property_event,
            event_types=[ChangeEvent.PROPERTY_ADDED],
        )


# ─── DOE HTTP endpoint ────────────────────────────────────────────────────────


# Map POST path to the doe direction it drives.
_DOE_PATHS = {
    "/doe/import-limit": "import-limit",
    "/doe/export-limit": "export-limit",
}


def _validate_doe_body(body: Any) -> Optional[list]:
    """
    Normalize and lightly validate a posted DOE body into an envelope array
    (or None to clear).

    Accepts None (clear), a single envelope object, or an array of them.
    Enforces the data-model invariants that are cheap to check here: at least
    one of `power-limit` / `apparent-power-limit` present and a non-negative
    integer, and `source` (if present) one of the defined enum values. Raises
    ValueError on a malformed body. Time-window sanity (ISO-8601, ordering) is
    left to the utility backhaul that would drive this in production.
    """
    if body is None:
        return None
    envelopes = [body] if isinstance(body, dict) else body
    if not isinstance(envelopes, list):
        raise ValueError("body must be an envelope object, an array, or null")
    for i, env in enumerate(envelopes):
        if not isinstance(env, dict):
            raise ValueError(f"envelope[{i}] must be an object")
        has_limit = False
        for key in ("power-limit", "apparent-power-limit"):
            if key not in env:
                continue
            has_limit = True
            v = env[key]
            if not isinstance(v, int) or isinstance(v, bool) or v < 0:
                raise ValueError(
                    f"envelope[{i}].{key} must be a non-negative integer"
                )
        if not has_limit:
            raise ValueError(
                f"envelope[{i}] must have power-limit or apparent-power-limit"
            )
        source = env.get("source")
        if source is not None and source not in DOE_SOURCES:
            raise ValueError(
                f"envelope[{i}].source must be one of {sorted(DOE_SOURCES)}"
            )
    return envelopes


class _DoeRequestHandler(BaseHTTPRequestHandler):
    """Tiny HTTP handler accepting DOE updates as JSON."""

    meter: UtilityMeter = None  # type: ignore[assignment]

    def log_message(self, format, *args):
        logging.getLogger("DoeEndpoint").info(
            "%s - - [%s] %s",
            self.address_string(),
            self.log_date_time_string(),
            format % args,
        )

    def do_POST(self):
        direction = _DOE_PATHS.get(self.path)
        if direction is None:
            self._reply(
                HTTPStatus.NOT_FOUND,
                {"error": "unknown path", "known": sorted(_DOE_PATHS)},
            )
            return
        length = int(self.headers.get("Content-Length", "0"))
        raw = self.rfile.read(length).decode("utf-8") if length else ""
        try:
            # An empty body clears the signal for this direction (same as null).
            body = json.loads(raw) if raw.strip() else None
        except Exception as exc:
            self._reply(HTTPStatus.BAD_REQUEST, {"error": f"invalid json: {exc}"})
            return
        try:
            envelopes = _validate_doe_body(body)
        except ValueError as exc:
            self._reply(HTTPStatus.BAD_REQUEST, {"error": str(exc)})
            return
        setter = (
            self.meter.set_doe_import_limit
            if direction == "import-limit"
            else self.meter.set_doe_export_limit
        )
        try:
            setter(envelopes)
        except Exception as exc:
            self._reply(
                HTTPStatus.INTERNAL_SERVER_ERROR, {"error": str(exc)}
            )
            return
        self._reply(
            HTTPStatus.OK,
            {
                "applied": {
                    "direction": direction,
                    "envelopes": envelopes,
                    "at": datetime.now(timezone.utc).isoformat(),
                }
            },
        )

    def _reply(self, status: HTTPStatus, payload: dict):
        body = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


def start_doe_endpoint(meter: UtilityMeter, port: int) -> ThreadingHTTPServer:
    handler = type(
        "BoundDoeRequestHandler", (_DoeRequestHandler,), {"meter": meter}
    )
    server = ThreadingHTTPServer(("127.0.0.1", port), handler)
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    logging.getLogger("DoeEndpoint").info(
        "reason=doeEndpointReady,port=%d,paths=%s", port, ",".join(sorted(_DOE_PATHS))
    )
    return server


# ─── Periodic tick ────────────────────────────────────────────────────────────


def start_tick_thread(meter: UtilityMeter, interval_s: float) -> threading.Event:
    stop = threading.Event()

    def _run():
        while not stop.is_set():
            try:
                meter.tick()
            except Exception:
                logging.exception("reason=tickException")
            stop.wait(interval_s)

    threading.Thread(target=_run, daemon=True).start()
    return stop


# ─── Entry point ──────────────────────────────────────────────────────────────


def _discover_broker(
    timeout: float, log: logging.Logger
) -> Optional[tuple]:
    """Discover an eBus broker over mDNS (`_secure-mqtt._tcp`).

    Returns (host, port) from the advertisement, preferring the spec `broker`
    TXT record (the `<host>.local` name the broker's cert SAN covers) and
    falling back to the SRV target. Returns None on timeout. Requires the
    optional `mdns` extra (zeroconf).
    """
    try:
        from zeroconf import ServiceBrowser, ServiceListener, Zeroconf
    except ImportError:
        log.error(
            "discovery needs the 'mdns' extra: pip install 'ebus-sdk[mdns]'"
        )
        return None

    service_type = "_secure-mqtt._tcp.local."
    found = threading.Event()
    result: Dict[str, Any] = {}

    class _Listener(ServiceListener):
        def add_service(self, zc, type_, name):
            info = zc.get_service_info(type_, name, timeout=3000)
            if info is None:
                return
            broker = info.properties.get(b"broker")
            result["host"] = (
                broker.decode() if broker else info.server.rstrip(".")
            )
            result["port"] = info.port or 8883
            found.set()

        def update_service(self, zc, type_, name):
            self.add_service(zc, type_, name)

        def remove_service(self, zc, type_, name):
            pass

    zc = Zeroconf()
    ServiceBrowser(zc, service_type, _Listener())
    try:
        if found.wait(timeout):
            return result["host"], result["port"]
        return None
    finally:
        zc.close()


def main():
    parser = argparse.ArgumentParser(
        description=(
            "eBus utility-meter publisher reference implementation."
        )
    )
    parser.add_argument(
        "-c",
        "--config",
        required=True,
        help="Path to the meter config JSON file (see "
        "utility-meter-cfg.example.json).",
    )
    parser.add_argument(
        "-b",
        "--broker-config",
        help="Path to the MQTT broker config JSON file. "
        f"Defaults to ${DEFAULT_BROKER_CFG_ENV} env var.",
    )
    parser.add_argument(
        "--discover",
        action="store_true",
        help="Discover the broker over mDNS (_secure-mqtt._tcp) and use the "
        "advertised host/port, overriding 'host'/'port' in the broker config. "
        "The broker config still supplies the TLS material.",
    )
    parser.add_argument(
        "--discover-timeout",
        type=float,
        default=8.0,
        help="Seconds to wait for mDNS broker discovery (default: 8.0).",
    )
    parser.add_argument(
        "--doe-port",
        type=int,
        default=DEFAULT_DOE_ENDPOINT_PORT,
        help="Port for the local DOE HTTP endpoint "
        f"(default: {DEFAULT_DOE_ENDPOINT_PORT}).",
    )
    parser.add_argument(
        "--tick-interval",
        type=float,
        default=5.0,
        help="Synthetic-update interval seconds (default: 5.0).",
    )
    args = parser.parse_args()

    # Logging
    logging.basicConfig()
    log = _make_logger("utility-meter")

    # Meter config
    with open(args.config, "r") as fp:
        meter_cfg = json.load(fp)

    # Broker config
    broker_cfg_path = args.broker_config or os.environ.get(
        DEFAULT_BROKER_CFG_ENV
    )
    if not broker_cfg_path:
        log.error(
            "no broker config; pass --broker-config or set %s",
            DEFAULT_BROKER_CFG_ENV,
        )
        sys.exit(2)
    mqtt_cfg = UtilityMeterAdapter.load_broker_config(broker_cfg_path)

    # Prefer an mDNS-discovered broker over the config's explicit host, per the
    # eBus broker-discovery flow. The broker config still supplies the TLS
    # material; discovery only fills in where to connect.
    if args.discover:
        endpoint = _discover_broker(args.discover_timeout, log)
        if endpoint is not None:
            mqtt_cfg["host"], mqtt_cfg["port"] = endpoint
            log.info(
                "reason=brokerDiscovered,host=%s,port=%d",
                mqtt_cfg["host"],
                mqtt_cfg["port"],
            )
        elif mqtt_cfg.get("host"):
            log.warning(
                "reason=brokerDiscoveryTimeout,fallbackHost=%s",
                mqtt_cfg["host"],
            )
        else:
            log.error(
                "broker discovery failed and no fallback 'host' in broker config"
            )
            sys.exit(2)

    # Resolve device identity from config
    device_id = meter_cfg.get("device-id") or meter_cfg.get("info", {}).get(
        "serial-number"
    )
    device_name = meter_cfg.get("device-name", "Utility Meter")
    if not device_id:
        log.error(
            "no device-id (and no info.serial-number) in meter config"
        )
        sys.exit(2)

    # Wire it up
    meter = UtilityMeter(meter_cfg, logger=_make_logger("UtilityMeter"))
    adapter = UtilityMeterAdapter(
        meter,
        device_id=device_id,
        device_name=device_name,
        mqtt_cfg=mqtt_cfg,
        logger=_make_logger("UtilityMeterAdapter"),
    )
    start_doe_endpoint(meter, args.doe_port)
    start_tick_thread(meter, args.tick_interval)

    log.info(
        "reason=utilityMeterReady,deviceId=%s,deviceType=%s",
        device_id,
        DEVICE_TYPE,
    )

    # Wait forever for an event that will never come
    threading.Event().wait()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
    except Exception as e:
        logging.exception(e)
        sys.exit(1)
